pipeline {
    agent any
    options { timestamps(); timeout(time: 30, unit: 'MINUTES') }
    parameters {
        string(name: 'LOOPS', defaultValue: '1', description: 'Loops of the script')
        string(name: 'TARGET_URL', defaultValue: 'http://localhost', description: 'Site to audit')
    }
    stages {
        stage('Install deps') {
            steps {
                dir('Front End Performance/LightHouse') {
                    bat 'dir'
                    bat 'node -v'
                    bat 'npm ci'
                }
            }
        }
        stage('Run Lighthouse') {
            steps {
                dir('Front End Performance/LightHouse') {
                    withEnv(["LH_RUNS=${params.LOOPS}", "APP_URL=${params.TARGET_URL}"]) {
                        bat 'node src\\runners\\run-lighthouse.js'
                    }
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'Front End Performance/LightHouse/results/**', allowEmptyArchive: true
        }
    }
}
