pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 40, unit: 'MINUTES')
    }

    parameters {
        string(name: 'THREADS',  defaultValue: '5',   description: 'Virtual users (3-5)')
        string(name: 'DURATION', defaultValue: '600', description: 'Test duration, seconds (10 min)')
    }

    environment {
        JMETER_HOME = 'C:\\Users\\PrathamGoswami\\apache-jmeter-5.6.3'
        JAVA_HOME   = 'C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.12.7-hotspot'
    }

    stages {
        stage('Clean') {
            steps {
                dir('Jmeter') {
                    bat 'if exist report rmdir /s /q report'
                    bat 'if exist run.jtl del /q run.jtl'
                }
            }
        }

        stage('Run JMeter') {
            steps {
                dir('Jmeter') {   // run from this folder so the relative path to "CSV Data.csv" works
                    bat """
                    set "PATH=%JAVA_HOME%\\bin;%PATH%"
                    if not exist "%JAVA_HOME%\\bin\\java.exe" exit /b 1
                    "%JAVA_HOME%\\bin\\java.exe" -version
                    "%JMETER_HOME%\\bin\\jmeter.bat" -n -t "furniture_store_test-plan.jmx" -l run.jtl -e -o report -Jthreads=${params.THREADS} -Jduration=${params.DURATION}
                    """
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'Jmeter/report/**, Jmeter/run.jtl', allowEmptyArchive: true

            // Requires the "HTML Publisher" plugin
            publishHTML(target: [
                reportDir: 'Jmeter/report',
                reportFiles: 'index.html',
                reportName: 'JMeter Report',
                keepAll: true,
                allowMissing: true,
                alwaysLinkToBuild: true
            ])
        }
    }
}
