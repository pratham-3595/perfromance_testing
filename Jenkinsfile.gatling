pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 40, unit: 'MINUTES')
    }

    parameters {
        string(name: 'BASE_URL', defaultValue: 'http://localhost', description: 'App under test')
        string(name: 'USERS',    defaultValue: '5',   description: 'Virtual users (3-5)')
        string(name: 'RAMP',     defaultValue: '30',  description: 'Ramp-up, seconds')
        string(name: 'DURATION', defaultValue: '600', description: 'Test duration, seconds (10 min)')
        choice(name: 'MODEL', choices: ['closed', 'open'], description: 'Load model')
    }

    environment {
        JAVA_HOME  = 'C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.12.7-hotspot'
        MAVEN_HOME = 'C:\\Users\\PrathamGoswami\\apache-maven-3.9.6'
    }

    stages {
        stage('Run Gatling') {
            steps {
                dir('Gatling') {
                    bat """
                    set "PATH=%JAVA_HOME%\\bin;%MAVEN_HOME%\\bin;%PATH%"
                    if not exist "%JAVA_HOME%\\bin\\java.exe" exit /b 1
                    if not exist "%MAVEN_HOME%\\bin\\mvn.cmd" exit /b 1
                    "%JAVA_HOME%\\bin\\java.exe" -version
                    "%MAVEN_HOME%\\bin\\mvn.cmd" -version
                    "%MAVEN_HOME%\\bin\\mvn.cmd" -B clean gatling:test -DbaseUrl="${params.BASE_URL}" -Dusers=${params.USERS} -DrampSeconds=${params.RAMP} -Dduration=${params.DURATION} -Dmodel=${params.MODEL}
                    """
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'Gatling/target/gatling/**', allowEmptyArchive: true

            // Requires the "HTML Publisher" plugin
            publishHTML(target: [
                reportDir: 'Gatling/target/gatling',
                reportFiles: '**/index.html',
                reportName: 'Gatling Report',
                keepAll: true,
                allowMissing: true,
                alwaysLinkToBuild: true
            ])
        }
    }
}
