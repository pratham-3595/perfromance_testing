          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*

// Generate a unique email for this order
String uniqueEmail = &quot;loadtest_&quot; + System.currentTimeMillis() + &quot;_&quot; + ctx.getThreadNum() + &quot;@example.com&quot;
vars.put(&quot;uniqueEmail&quot;, uniqueEmail)

// Get checkoutCartContent (from 05_02_Click_Place_Order extractors)
String cartContent = vars.get(&quot;checkoutCartContent&quot;)

// Safety check: if null or empty, log and use empty cart
if (cartContent == null || cartContent.trim().isEmpty()) {
    log.warn(&quot;checkoutCartContent is NULL or EMPTY! Check RE_checkoutCartContent extractor.&quot;)
    cartContent = &quot;{}&quot;
}

log.info(&quot;Raw Cart Content: &quot; + cartContent)

// Parse product IDs from cart JSON like {&quot;105__&quot;:1,&quot;89__&quot;:1}
def productIds = []
try {
    def matcher = (cartContent =~ /&quot;(\d+)__&quot;\s*:\s*(\d+)/)
    while (matcher.find()) {
        String productId = matcher.group(1)
        productIds.add(productId)
        log.info(&quot;Found product ID: &quot; + productId)
    }
} catch (Exception e) {
    log.error(&quot;Error parsing cart content: &quot; + e.getMessage())
}

// Store product count
int productCount = productIds.size()
vars.put(&quot;productCount&quot;, String.valueOf(productCount))
log.info(&quot;Total products in cart: &quot; + productCount)

// If no products found, log warning
if (productCount == 0) {
    log.warn(&quot;NO PRODUCTS FOUND in cart! This order will fail.&quot;)
}

// Store each product ID and build price parameters
for (int i = 0; i &lt; productIds.size(); i++) {
    String id = productIds[i]
    
    // Store product ID
    vars.put(&quot;cartProductId_&quot; + i, id)
    
    // Build field name: product_price_105__
    String fieldName = &quot;product_price_&quot; + id + &quot;__&quot;
    vars.put(&quot;cartProductPriceFieldName_&quot; + i, fieldName)
    
    // Get the price (set earlier when product was added to cart)
    String price = vars.get(&quot;price_&quot; + id)
    if (price == null || price.trim().isEmpty()) {
        log.warn(&quot;Price not found for product &quot; + id + &quot;, using 0.00&quot;)
        price = &quot;0.00&quot;
    }
    vars.put(&quot;cartProductPriceValue_&quot; + i, price)
    
    log.info(&quot;Product &quot; + i + &quot;: ID=&quot; + id + &quot;, Price=&quot; + price)
}

log.info(&quot;=== Submit Order PreProcessor Complete ===&quot;)
log.info(&quot;Unique Email: &quot; + uniqueEmail)
log.info(&quot;Product Count: &quot; + productCount)




log.info(&quot;=== Submit Order PreProcessor Complete ===&quot;)
log.info(&quot;Unique Email: &quot; + uniqueEmail)
log.info(&quot;Product Count: &quot; + productCount)

// ✅ FIX: Set default state if not provided
String state = vars.get(&quot;state&quot;)
if (state == null || state.trim().isEmpty()) {
    vars.put(&quot;state&quot;, &quot;N/A&quot;)
    log.info(&quot;State was empty, set to N/A&quot;)
}
</stringProp>
              <stringProp name="TestPlan.comments">to generate unique emails</stringProp>
            </JSR223PreProcessor>
