            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.util.regex.Pattern

// ----- helpers -----
def failMsg = { String msg -&gt;
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(msg)
}

// ----- response sanity -----
String body = prev.getResponseDataAsString()
String code = prev.getResponseCode()
String url  = (prev.getUrlAsString() ?: &quot;n/a&quot;)

if (code == null || !code.startsWith(&quot;2&quot;)) {
    failMsg(&quot;Cart page not OK. HTTP=&quot; + code + &quot; URL=&quot; + url)
    return
}
if (body == null || body.isEmpty()) {
    failMsg(&quot;Cart page empty response. HTTP=&quot; + code + &quot; URL=&quot; + url)
    return
}

// ----- get cart content JSON -----
// 1) try variable names that may already exist in your test plan
String cartContent = vars.get(&quot;cart_content&quot;)
if (!cartContent || cartContent == &quot;NOT_FOUND&quot;) cartContent = vars.get(&quot;cartContentFromCart&quot;)
if (!cartContent || cartContent == &quot;NOT_FOUND&quot;) cartContent = vars.get(&quot;cartContentFromCart_g1&quot;)
if (!cartContent || cartContent == &quot;NOT_FOUND&quot;) cartContent = vars.get(&quot;cartJson&quot;)

// 2) if still not found, parse directly from the cart page HTML
if (!cartContent || cartContent == &quot;NOT_FOUND&quot;) {
    def m = Pattern.compile(&apos;name=&quot;cart_content&quot;\\s+value=([&quot;\&apos;])(.*?)\\1&apos;, Pattern.DOTALL).matcher(body)
    if (m.find()) {
        cartContent = m.group(2)
    }
}

if (!cartContent || cartContent.trim().isEmpty() || cartContent == &quot;NOT_FOUND&quot;) {
    failMsg(&quot;cart_content not available (vars/extractor/HTML). URL=&quot; + url)
    return
}

// ----- extract expected product ids from cart content -----
def ids = new LinkedHashSet&lt;String&gt;()
def idM = Pattern.compile(&apos;&quot;?(\\d+)__&quot;?&apos;).matcher(cartContent)
while (idM.find()) {
    ids.add(idM.group(1))
}

if (ids.isEmpty()) {
    failMsg(&quot;No product IDs found in cart content: &quot; + cartContent)
    return
}

// ----- verify every id exists in HTML as data-p_id=&quot;ID&quot; (or &apos;ID&apos;) -----
def missing = new ArrayList&lt;String&gt;()
ids.each { String id -&gt;
    def p = Pattern.compile(&apos;data-p_id\\s*=\\s*[&quot;\&apos;]&apos; + Pattern.quote(id) + &apos;[&quot;\&apos;]&apos;)
    if (!p.matcher(body).find()) {
        missing.add(id)
    }
}

if (!missing.isEmpty()) {
    failMsg(&quot;Cart page missing product ID(s): &quot; + String.join(&quot;, &quot;, missing) + &quot; | cartContent=&quot; + cartContent)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="TestPlan.comments">verify all added products are present</stringProp>
            </JSR223Assertion>
