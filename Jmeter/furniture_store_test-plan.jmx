              <stringProp name="script">log.info(&quot;=== After Click Place Order ===&quot;)
log.info(&quot;checkoutCartContent: &quot; + vars.get(&quot;checkoutCartContent&quot;))
log.info(&quot;checkoutTransId: &quot; + vars.get(&quot;checkoutTransId&quot;))
log.info(&quot;checkoutTotalNet: &quot; + vars.get(&quot;checkoutTotalNet&quot;))

if (vars.get(&quot;checkoutCartContent&quot;) == null || vars.get(&quot;checkoutCartContent&quot;).equals(&quot;NOT_FOUND&quot;)) {
    log.error(&quot;CRITICAL: cart_content extraction FAILED!&quot;)
}</stringProp>
