        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="SC_Add_Product_To_Cart" enabled="true"/>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Add_To_Cart" enabled="true">
            <stringProp name="HTTPSampler.path">/wp-admin/admin-ajax.php</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments">
                <elementProp name="action" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">ic_add_to_cart</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                  <stringProp name="Argument.name">action</stringProp>
                </elementProp>
                <elementProp name="add_cart_data" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${addCartDataValue}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                  <stringProp name="Argument.name">add_cart_data</stringProp>
                </elementProp>
                <elementProp name="cart_widget" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">0</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                  <stringProp name="Argument.name">cart_widget</stringProp>
                </elementProp>
                <elementProp name="cart_container" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">0</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                  <stringProp name="Argument.name">cart_container</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.net.URLEncoder

// ---------- Read current cart ----------
String cartJson = vars.get(&quot;cartJson&quot;)
if (cartJson == null || cartJson.trim().isEmpty() || cartJson == &quot;NOT_FOUND&quot;) {
    cartJson = &quot;{}&quot;
}

// ---------- Read productId extracted from previous response ----------
String productId = vars.get(&quot;productId&quot;)

// ---------- Validate productId ----------
boolean invalidProduct =
        (productId == null) ||
        (productId.trim().isEmpty()) ||
        productId.equalsIgnoreCase(&quot;NOT_FOUND&quot;) ||
        !productId.trim().matches(&quot;\\d+&quot;)

if (invalidProduct) {
    log.warn(&quot;Skipping Add-to-Cart: invalid productId=[&quot; + productId + &quot;]. &quot; +
            &quot;Check extractor &amp; response flow. cartJson=&quot; + cartJson)

    // Signal to skip the HTTP Request using an If Controller
    vars.put(&quot;skipAddToCart&quot;, &quot;true&quot;)

    // Clear data so you don&apos;t reuse old value by mistake
    vars.remove(&quot;addCartDataValue&quot;)
    return
}

vars.put(&quot;skipAddToCart&quot;, &quot;false&quot;)
productId = productId.trim()

// ---------- Build POST body ----------
String encodedCartJson = URLEncoder.encode(cartJson, &quot;UTF-8&quot;)

String addCartData =
        &quot;current_product=&quot; + URLEncoder.encode(productId, &quot;UTF-8&quot;) +
        &quot;&amp;cart_content=&quot; + encodedCartJson +
        &quot;&amp;current_quantity=1&quot;

// Store for HTTP Request &quot;Body Data&quot; or parameter usage
vars.put(&quot;addCartDataValue&quot;, addCartData)

// ---------- Logs (optional) ----------
log.info(&quot;Adding product to cart: ID=&quot; + productId)
log.info(&quot;Cart JSON (raw): &quot; + cartJson)
log.info(&quot;Add-to-cart body: &quot; + addCartData)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="TestPlan.comments">builds the post request payload</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">String cartJson = vars.get(&quot;cartJson&quot;);
String productId = vars.get(&quot;productId&quot;);

if (cartJson == null || cartJson.trim().isEmpty()) {
    cartJson = &quot;{\&quot;&quot; + productId + &quot;__\&quot;:1}&quot;;
} else {
    // strip trailing }
    String inner = cartJson.substring(0, cartJson.length() - 1);
    cartJson = inner + &quot;,\&quot;&quot; + productId + &quot;__\&quot;:1}&quot;;
}

vars.put(&quot;cartJson&quot;, cartJson);
vars.put(&quot;price_&quot; + productId, vars.get(&quot;currentProductPrice&quot;));</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="TestPlan.comments">update the cart state after success</stringProp>
            </JSR223PostProcessor>
